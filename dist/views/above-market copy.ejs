    <body>
        <header>
    
          <div class="headerlogo">
            <img src="images/logo.png" alt="">
            <span class="navtittile fw-bold fs-5">Occasion-Motivation Forecasting</span>
          </div>  
          <div>
            <a id="downloadReportBtn" class="btn btn-primary">Download Report (Excel)</a>
          </div>
        </header>
        
        <div class="container mt-4 content-below-header pb-3">
          <h2 class="mb-1">Market Filter</h2>
        
          <form id="filterForm" class="mt-3">
            <div class="row">
             <div class="filtercontainer">
              <div class="col-md-3">
              <div class="form-group">
                <label for="marketType" class="form-label">Market Type</label>
                <select id="marketType" name="marketType" class="form-select" style="min-width: 200px;">
                  <option value="">-- Select Market Type --</option>
                  <% marketTypes.forEach(type => { %>
                    <option value="<%= type %>"><%= type %></option>
                  <% }) %>
                </select>
              </div></div>
            <div class="col-md-3">
              <div class="form-group">
                <label for="region" class="form-label">Region</label>
                <select id="region" name="region" class="form-select" style="min-width: 200px;">
                  <option value="">-- Select Region --</option>
                  <% regions.forEach(r => { %>
                    <option value="<%= r.name %>"><%= r.name %></option>
                  <% }) %>
                </select>
              </div></div>
              <div class="col-md-3">
              <div class="form-group">
                <label for="marketName" class="form-label">Market Name</label>
                <select id="marketName" name="marketName" class="form-select" multiple></select>
              </div></div>
        
              <button type="button" id="applyFilterBtn" class="btn btn-primary">
                Apply Filter
              </button>
              </div>
            </div>
          </form>
        </div>
        <div class="container-fluid">
          <div class="table-responsive table-ht">
        <div id="resultsTable" class="mt-4"></div>
        </div>
         

        <div class="filtertablechart">
          <div class="container mt-5">
            <h3>Top 10 Incremental Growth</h3>
            <canvas id="incrementalGrowthChart" style="max-width: 900px; height: 400px;"></canvas>
          </div>
          <div class="container mt-5">
            <h3>Top 10 Biggest Future Value Pools</h3>
            <canvas id="futureValueChart" style="max-width: 900px; height: 400px;"></canvas>
          </div>

          <div class="container mt-5">
            <h3>Greatest Incrementality Valuepool</h3>
            <canvas id="gratestValueChart" style="max-width: 900px; height: 400px;"></canvas>
          </div>
        </div>





        </div>

    <script nonce="<%= nonce %>" type="module" src="js/choices.min.js"></script>
    <script nonce="<%= nonce %>" src="/js/jquery.min.js"></script>
    <script type="module" src="/js/am-report.js"></script>
    <script nonce="<%= nonce %>" src="/boostrap/bootstrap.min.js"></script>
      <script src="/js/lib/chart.js"></script>

    </body>
    