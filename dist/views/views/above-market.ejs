  </div>

  <!-- Ensemble Weight Selection Modal -->
  <div class="modal fade" id="ensembleModal" tabindex="-1" role="dialog" aria-labelledby="ensembleModalLabel">
    <div class="modal-dialog modal-lg" role="document">
      <div class="modal-content">
        <div class="modal-header">
          <button type="button" class="close" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">&times;</span>
          </button>
          <h4 class="modal-title" id="ensembleModalLabel">
            <i class="fa fa-sliders"></i> Select Ensemble Weights
          </h4>
        </div>
        <div class="modal-body">
          <div class="alert alert-info">
            <i class="fa fa-info-circle"></i>
            <strong>Instructions:</strong>
            <ol style="margin-bottom: 0;">
              <li>Use search to filter markets or browse through accordion groups</li>
              <li>Select ensemble weights (50-50, 75-25, or 100-0) for each market</li>
              <li>Use bulk actions to apply same weight to multiple markets</li>
              <li>Click <strong>"Preview Data"</strong> to see the combined results</li>
              <li>If satisfied, click <strong>"Confirm & Apply"</strong> to apply</li>
            </ol>
          </div>

          <!-- Search and Bulk Actions -->
          <div class="ensemble-controls-section">
            <div class="row">
              <div class="col-md-5">
                <div class="input-group">
                  <span class="input-group-addon">
                    <i class="fa fa-search"></i>
                  </span>
                  <input type="text" id="marketSearchInput" class="form-control" placeholder="Search markets..."
                    autocomplete="off">
                </div>
                <small class="text-muted">
                  <span id="searchResultCount"></span>
                </small>
              </div>
              <div class="col-md-7">
                <div class="bulk-actions-panel">
                  <div class="btn-group btn-group-sm" role="group">
                    <button type="button" class="btn btn-default" id="bulkSelectAll">
                      <i class="fa fa-check-square-o"></i> Select All
                    </button>
                    <button type="button" class="btn btn-default" id="bulkDeselectAll">
                      <i class="fa fa-square-o"></i> Clear All
                    </button>
                  </div>
                  <div class="btn-group btn-group-sm" role="group" style="margin-left: 8px;">
                    <button type="button" class="btn btn-default dropdown-toggle" data-toggle="dropdown">
                      <i class="fa fa-magic"></i> Apply to Visible <span class="caret"></span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-right">
                      <li><a href="#" data-bulk-weight="100-0">100-0 to all visible</a></li>
                      <li><a href="#" data-bulk-weight="75-25">75-25 to all visible</a></li>
                      <li><a href="#" data-bulk-weight="50-50">50-50 to all visible</a></li>
                      <li role="separator" class="divider"></li>
                      <li><a href="#" data-bulk-weight="">Clear all visible</a></li>
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Market Count Badge -->
          <div class="market-stats-badge mb-3">
            <span class="badge badge-primary">
              <i class="fa fa-map-marker"></i>
              <span id="selectedMarketsCount">0</span> of <span id="totalMarketsCount">0</span> markets configured
            </span>
          </div>

          <!-- Accordion Container -->
          <div id="ensembleSelectors" class="ensemble-accordion-container"></div>

          <div id="ensemblePreview">
            <h5 style="margin-bottom: 15px;"><i class="fa fa-table"></i> Data Preview</h5>
            <div id="ensemblePreviewContent" class="ensemble-preview-content">
              <p class="text-muted">Select an ensemble weight to preview data...</p>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-default" data-dismiss="modal">
            <i class="fa fa-times"></i> Cancel
          </button>
          <button type="button" id="previewEnsembleBtn" class="btn btn-info">
            <i class="fa fa-eye"></i> Preview Data
          </button>
          <button type="button" id="confirmEnsembleBtn" class="btn btn-success">
            <i class="fa fa-check"></i> Confirm & Apply
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Scripts -->
  <script nonce="<%= nonce %>" src="/js/jquery.min.js"></script>
  <script nonce="<%= nonce %>" src="/boostrap/bootstrap.min.js"></script>
  <script nonce="<%= nonce %>" type="module" src="/js/choices.min.js"></script>

  <!-- DataTables JS -->
  <script nonce="<%= nonce %>" src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
  <script nonce="<%= nonce %>" src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
  <script nonce="<%= nonce %>"
    src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
  <script nonce="<%= nonce %>"
    src="https://cdn.datatables.net/responsive/2.5.0/js/responsive.bootstrap5.min.js"></script>
  <script nonce="<%= nonce %>" src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
  <script nonce="<%= nonce %>" src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.bootstrap5.min.js"></script>

  <!-- Overlay Loading Indicator -->
  <div id="processingOverlay" class="processing-overlay">
    <div class="processing-content">
      <div class="processing-spinner">
        <i class="fa fa-spinner fa-spin"></i>
      </div>
      <h3 class="processing-title">Processing Ensemble Data</h3>
      <p class="processing-text">Building your results…</p>
      <p class="processing-subtext">Hang tight. We’re almost there.</p>
    </div>
  </div>

  <script nonce="<%= nonce %>" type="module" src="/js/am-report.js?v=2.4"></script>
  <script nonce="<%= nonce %>" src="/js/lib/chart.js"></script>

</body>

</html>