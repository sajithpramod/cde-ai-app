<!DOCTYPE html>
<html lang="en">

<head>
  <base href="/" />
  <meta charset="UTF-8" />
  <meta name="csp-nonce" content="<%= nonce %>">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <link rel="preload" href="font/SegoeUIThis-BoldItalic.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="boostrap/bootstrap.min.css">
  <link rel="stylesheet" href="font/font.css">
  <link rel="stylesheet" href="/css/bootstrap-icons.css">
  <link rel="stylesheet" href="font-awesome/font-awesome.css">
  <link rel="stylesheet" href="/css/choices.min.css">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/above-market.css">
  <link rel="stylesheet" href="/css/ensemble-modal.css">

  <!-- DataTables CSS -->
  <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css">
  <link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap5.min.css">
  <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.bootstrap5.min.css">

  <title>Occasion-Motivation Forecasting</title>

</head>

<body>
  <!-- Header -->
  <header class="header">
    <div class="headerlogo d-flex align-items-center">
      <!-- <img src="/images/logo.png" alt="Logo"  style="height: 40px;" /> -->
      <div class="headerlogo"><img src="images/logo.png" alt="" /><span class="navtittile">Occasion-Motivation
          Forecasting</span></div>

    </div>
    <div class="d-flex align-items-center" style="gap: 10px;">
      <a href="/dashboard" class="btn btn-secondary">
        <i class="fa fa-arrow-left me-2"></i>Back to Dashboard
      </a>
      <button type="button" id="downloadReportBtn" class="btn btn-primary">
        <i class="fa fa-download me-2"></i>Download Report (Excel)
      </button>
      <a href="/auth/logout" class="btn btn-danger">
        <i class="fa fa-sign-out me-2"></i>Logout
      </a>
    </div>
  </header>

  <div class="container-fluidlarge content-below-header text-center py-2">
    <h1 class="navtitle mb-0 hm">Above Market Report</h1>
  </div>

  <!-- Filter Section -->
  <div class="container-fluidlarge mt-2 content-below-header ppt-3">
    <div class="filter-section">
      <h2><i class="fa fa-filter me-2"></i>Market Filter</h2>
      <form id="filterForm">
        <div class="filtercontainer">
          <div class="row g-3">
            <div class="col-md-3">
              <div class="form-group">
                <label for="marketType" class="form-label">
                  <i class="fa fa-building me-2"></i>Market Type
                </label>
                <select id="marketType" name="marketType" class="form-select">
                  <option value="">-- Select Market Type --</option>
                  <% marketTypes.forEach(type=> { %>
                    <option value="<%= type %>">
                      <%= type %>
                    </option>
                    <% }) %>
                </select>
              </div>
            </div>

            <div class="col-md-3">
              <div class="form-group">
                <label for="region" class="form-label">
                  <i class="fa fa-globe me-2"></i>Region
                </label>
                <select id="region" name="region" class="form-select">
                  <option value="">-- Select Region --</option>
                  <% regions.forEach(r=> { %>
                    <option value="<%= r.name %>">
                      <%= r.name %>
                    </option>
                    <% }) %>
                </select>
              </div>
            </div>

            <div class="col-md-4">
              <div class="form-group">
                <label for="marketName" class="form-label">
                  <i class="fa fa-map-marker me-2"></i>Market Name
                </label>
                <select id="marketName" name="marketName" class="form-select" multiple></select>
              </div>
            </div>

            <div class="col-md-2 d-flex align-items-end">
              <button type="button" id="applyFilterBtn" class="btn btn-primary w-100">
                <i class="fa fa-check me-2"></i>Apply Filter
              </button>
            </div>
          </div>
        </div>
      </form>
    </div>
  </div>



  <!-- Results Table -->
  <div class="container-fluidlarge marketfiltertcontainer">
    <div class="panel-group" id="accordion">

      <!-- Top 10 Incremental Growth Table -->
      <div class="panel panel-default">
        <div class="panel-heading" data-toggle="collapse" data-parent="#accordion" href="#IncrementalGrowth">
          <h4 class="panel-title">
            <a>
              <span><i class="fa fa-table me-2"></i>Final Category - Data Table</span>
              <i class="fa fa-angle-down" aria-hidden="true"></i>
            </a>
          </h4>
        </div>
        <div id="IncrementalGrowth" class="panel-collapse collapse in">
          <div class="panel-body">
            <div class="table-container">
              <div id="resultsTable"></div>
            </div>

            <!-- Ensemble Weight Question -->
            <div id="ensembleQuestion" class="ensemble-question" style="display: none;">
              <div class="alert alert-info mt-4">
                <h4><i class="fa fa-question-circle me-2"></i>Do you want to change ensemble weight?</h4>
                <p class="mb-3">Select different ensemble weights for each market to see customized forecasts.</p>
                <div class="btn-group">
                  <button type="button" id="ensembleYesBtn" class="btn btn-primary">
                    <i class="fa fa-check me-2"></i>Yes
                  </button>
                  <button type="button" id="ensembleNoBtn" class="btn btn-secondary">
                    <i class="fa fa-times me-2"></i>No, use default
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Charts Section -->
      <div class="panel panel-default">
        <div class="panel-heading" data-toggle="collapse" data-parent="#accordion" href="#FutureValue">
          <h4 class="panel-title">
            <a>
              <span><i class="fa fa-bar-chart me-2"></i>Value Pool Charts</span>
              <i class="fa fa-angle-down" aria-hidden="true"></i>
            </a>
          </h4>
        </div>
        <div id="FutureValue" class="panel-collapse collapse">
          <div class="panel-body">
            <div class="row">
              <div class="col-md-6">
                <div class="chart-wrapper">
                  <h3><i class="fa fa-line-chart me-2"></i>Top 10 Incremental Growth</h3>
                  <canvas id="incrementalGrowthChart" class="chartFrame"></canvas>
                </div>
              </div>
              <div class="col-md-6">
                <div class="chart-wrapper">
                  <h3><i class="fa fa-pie-chart me-2"></i>Top 10 Biggest Future Value Pools</h3>
                  <canvas id="futureValueChart" class="chartFrame"></canvas>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Greatest Incrementality Valuepool -->
      <div class="panel panel-default">
        <div class="panel-heading" data-toggle="collapse" data-parent="#accordion" href="#GreatestValuepool">
          <h4 class="panel-title">
            <a>
              <span><i class="fa fa-star me-2"></i>Greatest Incrementality Valuepool</span>
              <i class="fa fa-angle-down" aria-hidden="true"></i>
            </a>
          </h4>
        </div>
        <div id="GreatestValuepool" class="panel-collapse collapse">
          <div class="panel-body">
            <div class="row">
              <div class="col-md-12">
                <div class="chart-wrapper">
                  <h3><i class="fa fa-trophy me-2"></i>Greatest Incrementality Valuepool</h3>
                  <canvas id="gratestValueChart" class="chartFrame"></canvas>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Mekko Charts Section -->
      <div class="panel panel-default">
        <div class="panel-heading" data-toggle="collapse" data-parent="#accordion" href="#MekkoCharts">
          <h4 class="panel-title">
            <a>
              <span><i class="fa fa-area-chart me-2"></i>Value Pool Mekko Charts</span>
              <i class="fa fa-angle-down" aria-hidden="true"></i>
            </a>
          </h4>
        </div>
        <div id="MekkoCharts" class="panel-collapse collapse">
          <div class="panel-body">
            <div class="row">
              <div class="col-md-12">
                <div class="mekko-container">
                  <h3><i class="fa fa-bar-chart me-2"></i>Current Value Pool</h3>
                  <div style="width: 100%; height: 600px;">
                    <iframe id="currentValuePoolFrame" class="mekkoFrame"></iframe>
                  </div>
                </div>
              </div>
            </div>
            <div class="row">
              <div class="col-md-12">
                <div class="mekko-container">
                  <h3><i class="fa fa-line-chart me-2"></i>Forecasted Value Pool</h3>
                  <div nonce="<%= nonce %>" style="width: 100%; height: 600px;">
                    <iframe id="forecastedValuePoolFrame" class="mekkoFrame"></iframe>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Bubble Chart Section -->
      <div class="panel panel-default">
        <div class="panel-heading" data-toggle="collapse" data-parent="#accordion" href="#BubbleChart">
          <h4 class="panel-title">
            <a>
              <span><i class="fa fa-circle-o me-2"></i>Bubble Chart Analysis</span>
              <i class="fa fa-angle-down" aria-hidden="true"></i>
            </a>
          </h4>
        </div>
        <div id="BubbleChart" class="panel-collapse collapse">
          <div class="panel-body">
            <div class="row">
              <div class="col-md-12">
                <div class="mekko-container">
                  <h3><i class="fa fa-dot-circle-o me-2"></i>Interactive Bubble Chart</h3>
                  <div nonce="<%= nonce %>" style="width: 100%; height: 700px;">
                    <iframe id="bubbleChartFrame" class="mekkoFrame"></iframe>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>




  <!-- Charts with Collapsible Cards
 <div class="mt-5 chart-collapse">
    <div class="accordion" id="chartAccordion">

      Incremental Growth 
      <div class="card mb-3">
        <div class="card-header" id="headingOne" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true">
          <h5 class="mb-0"></h5>
        </div>
        <div id="collapseOne" class="collapse show" data-bs-parent="#chartAccordion">
          <div class="card-body text-center">
          </div>
        </div>
      </div>

      <div class="card mb-3">
        <div class="card-header" id="headingTwo" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false">
          <h5 class="mb-0"></h5>
        </div>
        <div id="collapseTwo" class="collapse" data-bs-parent="#chartAccordion">
          <div class="card-body text-center">
        
          </div>
        </div>
      </div>

       Greatest Incrementality Valuepool
      <div class="card mb-3">
        <div class="card-header" id="headingThree" data-bs-toggle="collapse" data-bs-target="#collapseThree" aria-expanded="false">
          <h5 class="mb-0"></h5>
        </div>
        <div id="collapseThree" class="collapse" data-bs-parent="#chartAccordion">
          <div class="card-body text-center">
          </div>
        </div>
      </div>
  </div>

    </div> -->
  </div>

  <!-- Ensemble Weight Selection Modal -->
  <div class="modal fade" id="ensembleModal" tabindex="-1" aria-labelledby="ensembleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="ensembleModalLabel">
            <i class="fa fa-sliders me-2"></i>Select Ensemble Weights
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="alert alert-info">
            <i class="fa fa-info-circle me-2"></i>
            <strong>Instructions:</strong> Select an ensemble weight for each market below.
            You can choose different weights for different markets, or skip markets to use default data.
          </div>

          <div id="ensembleSelectors" class="mb-4"></div>

          <div id="ensemblePreview">
            <h6 class="mb-3"><i class="fa fa-table me-2"></i>Data Preview</h6>
            <div id="ensemblePreviewContent" class="ensemble-preview-content">
              <p class="text-muted">Select an ensemble weight to preview data...</p>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
            <i class="fa fa-times me-2"></i>Cancel
          </button>
          <button type="button" id="confirmEnsembleBtn" class="btn btn-primary">
            <i class="fa fa-check me-2"></i>Confirm & Apply
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Scripts -->
  <script nonce="<%= nonce %>" src="/js/jquery.min.js"></script>
  <script nonce="<%= nonce %>" src="/boostrap/bootstrap.min.js"></script>
  <script nonce="<%= nonce %>" type="module" src="/js/choices.min.js"></script>

  <!-- DataTables JS -->
  <script nonce="<%= nonce %>" src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
  <script nonce="<%= nonce %>" src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
  <script nonce="<%= nonce %>"
    src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
  <script nonce="<%= nonce %>"
    src="https://cdn.datatables.net/responsive/2.5.0/js/responsive.bootstrap5.min.js"></script>
  <script nonce="<%= nonce %>" src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
  <script nonce="<%= nonce %>" src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.bootstrap5.min.js"></script>

  <script nonce="<%= nonce %>" type="module" src="/js/am-report.js"></script>
  <script nonce="<%= nonce %>" src="/js/lib/chart.js"></script>

</body>

</html>