<div class="panel-group" id="accordion">
  <div class="panel panel-default">
    <div class="panel-heading">
      <h4 class="panel-title">
        <a data-toggle="collapse" data-parent="#accordion" href="#collapse1">
        Current TBA Value Pools​ <i class="fa fa-angle-up align-right " aria-hidden="true"></i>
    </a>
      </h4>
    </div>
    <div id="collapse1" class="panel-collapse collapse in">
      <div class="panel-body">
        <% const tbaRsv = data['TBA_RSV_Output']; %>
        <% if (tbaRsv && tbaRsv.length > 0) { %>
          <div class="table-responsive">
       <table class="table table-hover tbyllow" id="TBA_RSV_Output">
        <% const cols = Object.keys(tbaRsv[0]); %>
    <thead>
      <tr>
        <% cols.forEach((col, index) => { 
          const label = col
            .replace(/[._]/g, ' ')                   // Replace dot/underscore with space
            .replace(/([a-z])([A-Z])/g, '$1 $2')     // Handle camelCase
            .split(' ')
            .map(w => w.charAt(0).toUpperCase() + w.slice(1))
            .join(' ');
        %>
        <th data-val="<%= col %>" class="<%= getTierColumnBg(label) %>"><%= label %></th>
        <% }) %>
      </tr>
    </thead>
   
    <tbody>
      <% tbaRsv.forEach(row => { %>
        <tr>
          <% Object.entries(row).forEach(([key, value]) => { %>
            <td>
              <%= key === 'price.tier' ? String(value).toUpperCase() : value %>
            </td>
          <% }) %>
        </tr>
      <% }) %>
    </tbody>
  </table>
  </div>
  <% } else { %>
    <p>No data found for TBA RSV</p>
  <% } %>
      </div>
    </div>
  </div>
