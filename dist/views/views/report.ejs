        <div class="col-md-3">
          <!-- Table 1: Occasion Motivation -->
          <div class="card p-3 mb-3 mt-10">
            <h4>Occasion Motivations</h4>
            <% const OmSummTba = data['OM_summ_tba']; %>
            <% if (OmSummTba && OmSummTba.length > 0) { %>
            <table class="table table-sm table-striped" id="OM_summ_tba">
              <tbody>
                <% OmSummTba.forEach(row => {
                  const firstCol = row['Occasion_Motivation'].charAt(0).toUpperCase() + row['Occasion_Motivation'].slice(1).toLowerCase();
                %>
                <tr>
                  <td class="<%= getTierColumnBg(firstCol) %>"><%= firstCol %></td>
                  <td><%= row['Share']%></td>
                </tr>
                <% }) %>
              </tbody>
              <% } %>
            </table>
          </div>
    
          <!-- Table 2: Price Tier -->
          <div class="card p-3">
            <h4>Value Pools</h4>
            <table class="table table-sm table-striped" id="PT_summ_tba">
              <% const PtSummTba = data['PT_summ_tba']; %>
              <% if (PtSummTba && PtSummTba.length > 0) { %>
              <tbody>
                <% PtSummTba.forEach(row => { %>
                <tr>
                  <td><%= row['price.tier'] %></td>
                  <td><%= row['Shares'] %></td>
                </tr>
                <% }) %>
              </tbody>
              <% } %> 
            </table>
          </div>
        </div>
      </div>
