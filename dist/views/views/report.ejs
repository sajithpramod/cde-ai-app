        <h1>Current TBA Value Pools</h1>
        <div class="chart-border">
          <div id="chart1">
         <%- mekkochart1 %>
        </div>
        <div id="loadingSpinner">Loading chart...</div>
         <iframe id="mekkoFrame" width="100%" height="600" class="framStyle hidden"></iframe>
        </div>
