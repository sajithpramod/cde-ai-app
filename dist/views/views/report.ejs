<div id="mekkomodal" class="modal fade mekkomodalcontainer" role="dialog">
  <div class="modal-dialog">

    <!-- Modal content-->
    <div class="modal-content">
    <div class="modal-header">
      <button type="button" class="close-modal-icon" data-dismiss="modal"><img src="images/close-icon.svg" alt="Close"></button>
      <h4 class="modal-title">Decision Matrix</h4>
     
    </div>
    <div class="modal-body">
      <% 
        const cyear = data['Current_year'];
        const currentYear = cyear[0]['Current.Year'];
        let forcastedYear = '';
       
        if (cyear && cyear.length > 0 && cyear[0]['Current.Year']) {
          const rawYear = cyear[0]['Current.Year'];
          forcastedYear = parseInt(rawYear) + parseInt(duration);
        }
      %>
      <h3>
        <span>Current Year: <%= currentYear %></span>
        &nbsp;|&nbsp;
        <span>Forecasted Year: <%= forcastedYear %></span>
      </h3>
          <div class="table-responsive">
            <% const decisionMatrix = data['Decision Matrix']; %>
            <% if (decisionMatrix && decisionMatrix.length > 0) { %> 
              <div style="overflow-x: auto; max-width: 100%;">
      <table class="table table-hover" id="Decision-Matrix" style="min-width: 1000px; table-layout: fixed;">
        <% const cols = Object.keys(decisionMatrix[0]); %>
    <thead>
      <tr>
        <% cols.forEach((col, index) => { 
          const label = col
            .replace(/[._]/g, ' ')                   // Replace dot/underscore with space
            .replace(/([a-z])([A-Z])/g, '$1 $2')     // Handle camelCase
            .split(' ')
            .map(w => w.charAt(0).toUpperCase() + w.slice(1))
            .join(' ');
        %>
        <th data-val="<%= col %>"><%= label %></th>
        <% }) %>

      </tr>
    </thead>
    <tbody>
      <%
          function getRoleClass(role) {
            switch (role) {
              case 'Invest to grow(ahead)':
              return 'role-ahead';
              case 'Invest to grow(now)':
              return 'role-now';
              case 'Selective Plays':
              return 'role-selective';
              case 'Maintain':
              return 'role-maintain ';
              default:
                return '';
            }
          }
      %>
      <% decisionMatrix.forEach(row => { %>
        <tr>
          <td data-fulltext="<%= row['Valuepool'] %>"><%= row['Valuepool'].toUpperCase() %></td>
          <td title="<%= row['CurrentRSV'] %>"><%= row['CurrentRSV']%></td>
          <td title="<%= row['ContributionbyValuepool'] %>"><%= row['ContributionbyValuepool']%></td>
          <td title="<%= row['FutureRSV'] %>"><%= row['FutureRSV']%></td>
          <td title="<%= row['FutureContribyValuepool'] %>"><%= row['FutureContribyValuepool']%></td>
          <td title="<%= row['CAGR'] %>"><%= row['CAGR']%></td>
          <td title="<%= row['INCRSV'] %>"><%= row['INCRSV']%></td>
          <td title="<%= row['DiagecurrentRSV'] %>"><%= row['DiagecurrentRSV']%></td>
