{
    "name": "forecasting-app",
    "version": "1.0.0",
    "description": "Occasion Forecasting App with SSO, R Script Execution, File Upload, and XLSX Report Viewer",
    "main": "dist/server.js",
    "scripts": {
        "start": "node dist/server.js",
        "start:dev": "ts-node-dev --respawn --transpile-only server.ts",
        "build": "npm run build:backend && npm run build:frontend",
        "build:backend": "tsc && cp -r views dist/views",
        "build:frontend": "esbuild public/js/main.js --bundle --minify --outfile=public/dist/bundle.js",
        "build:watch": "tsc --watch",
        "dev": "esbuild public/js/main.js --bundle --outfile=public/dist/bundle.js --sourcemap --watch",
        "migrate": "knex migrate:latest",
        "rollback": "knex migrate:rollback",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "test:verbose": "jest --verbose",
        "test:unit": "jest __tests__/unit",
        "test:integration": "jest __tests__/integration",
        "type-check": "tsc --noEmit"
    },
    "dependencies": {
        "@azure/storage-blob": "^12.29.1",
        "@dr.pogodin/csurf": "^1.14.0",
        "@node-saml/passport-saml": "^5.0.1",
        "anychart": "^8.13.1",
        "compression": "^1.8.0",
        "cookie-parser": "^1.4.6",
        "cors": "^2.8.5",
        "csv-parser": "^3.2.0",
        "dotenv": "^16.3.1",
        "ejs": "^3.1.10",
        "exceljs": "^4.4.0",
        "express": "^4.19.2",
        "express-ejs-layouts": "^2.5.1",
        "express-rate-limit": "^7.5.1",
        "express-session": "^1.17.3",
        "express-validator": "^7.2.1",
        "file-type": "^21.0.0",
        "helmet": "^7.0.0",
        "image-size": "^2.0.2",
        "joi": "^17.13.3",
        "jsdom": "^26.1.0",
        "knex": "^3.1.0",
        "multer": "^1.4.5-lts.1",
        "officegen": "^0.6.5",
        "passport": "^0.7.0",
        "passport-azure-ad": "^4.3.5",
        "pg": "^8.11.3",
        "socket.io": "^4.7.2",
        "winston": "^3.15.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.30.0",
        "@types/compression": "^1.8.1",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/express-ejs-layouts": "^2.5.4",
        "@types/express-session": "^1.18.2",
        "@types/express-validator": "^2.20.33",
        "@types/jest": "^30.0.0",
        "@types/jsdom": "^27.0.0",
        "@types/multer": "^2.0.0",
        "@types/node": "^25.0.3",
        "@types/passport": "^1.0.17",
        "@types/passport-azure-ad": "^4.3.6",
        "@types/pg": "^8.16.0",
        "@types/socket.io": "^3.0.1",
        "@types/validator": "^13.15.10",
        "esbuild": "^0.25.8",
        "eslint": "^9.30.0",
        "eslint-define-config": "^2.1.0",
        "eslint-plugin-security": "^3.0.1",
        "globals": "^16.2.0",
        "jest": "^29.7.0",
        "nodemon": "^3.1.10",
        "supertest": "^7.1.4",
        "ts-node": "^10.9.2",
        "ts-node-dev": "^2.0.0",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.9.3"
    },
    "overrides": {
        "js-yaml": "^4.1.0"
    },
    "keywords": [],
