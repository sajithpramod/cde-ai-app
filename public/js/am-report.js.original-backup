// Helper functions for graph visibility
function hideAllGraphs() {
    document.getElementById('FutureValue').classList.remove('in');
    document.getElementById('GreatestValuepool').classList.remove('in');
    document.getElementById('MekkoCharts').classList.remove('in');
    document.getElementById('BubbleChart').classList.remove('in');
}

function showAllGraphs() {
    document.getElementById('FutureValue').classList.add('in');
    document.getElementById('GreatestValuepool').classList.add('in');
    document.getElementById('MekkoCharts').classList.add('in');
    document.getElementById('BubbleChart').classList.add('in');
}

function showEnsembleQuestion() {
    document.getElementById('ensembleQuestion').style.display = 'block';
}

function hideEnsembleQuestion() {
    document.getElementById('ensembleQuestion').style.display = 'none';
}

// Ensemble "No" button handler - use default data and show all graphs
document.addEventListener('DOMContentLoaded', () => {
    const ensembleNoBtn = document.getElementById('ensembleNoBtn');
    if (ensembleNoBtn) {
        ensembleNoBtn.addEventListener('click', async () => {
            hideEnsembleQuestion();

            const { marketType, region, marketsParam } = window.currentFilterState || {};
            if (!marketType || !region || !marketsParam) {
                showFlashMessage('Filter state not found. Please apply filter again.', 'warning', 5000);
                return;
            }

            // Load all graphs with default data
            await renderIncrementalChart(marketType);
            await renderFutureValueChart(marketType, region, marketsParam);
            await rendergreatestIncrementalityValuepoolChart(marketType, region, marketsParam);
            await renderMekkoCharts(marketType);
            await renderBubbleChart(marketType);

            // Show all graph sections
            showAllGraphs();
        });
    }
});

// Ensemble "Yes" button handler - open modal
document.addEventListener('DOMContentLoaded', () => {
    const ensembleYesBtn = document.getElementById('ensembleYesBtn');
    if (ensembleYesBtn) {
        ensembleYesBtn.addEventListener('click', () => {
            const { selectedMarkets } = window.currentFilterState || {};
            if (!selectedMarkets || selectedMarkets.length === 0) {
                showFlashMessage('No markets selected. Please apply filter again.', 'warning', 5000);
                return;
            }

            // Populate modal with ensemble selectors
            populateEnsembleSelectors(selectedMarkets);

            // Open modal
            const modal = new bootstrap.Modal(document.getElementById('ensembleModal'));
            modal.show();
        });
    }
});

// Populate ensemble selectors in modal
function populateEnsembleSelectors(markets) {
    const container = document.getElementById('ensembleSelectors');
    container.innerHTML = '';

    markets.forEach(market => {
        const selectorDiv = document.createElement('div');
        selectorDiv.className = 'ensemble-selector mb-3 p-3 border rounded';
        selectorDiv.innerHTML = `
            <h6 class="mb-2"><i class="fa fa-map-marker me-2"></i>${market}</h6>
            <select class="form-select ensemble-weight-select" data-market="${market}">
                <option value="">-- Skip (Use Default) --</option>
                <option value="100-0">100-0</option>
                <option value="75-25">75-25</option>
                <option value="50-50">50-50</option>
            </select>
        `;
        container.appendChild(selectorDiv);

        // Add change event listener
        const select = selectorDiv.querySelector('.ensemble-weight-select');
        select.addEventListener('change', (e) => handleEnsembleWeightChange(e));
    });
}

// Handle ensemble weight selection change
async function handleEnsembleWeightChange(event) {
    const market = event.target.dataset.market;
    const ensembleWeight = event.target.value;

    if (!ensembleWeight) {
        // User selected "Skip" - clear preview for this market
        clearPreviewForMarket(market);
        return;
    }

    // Show loading state
    const previewContent = document.getElementById('ensemblePreviewContent');
    const loadingDiv = document.createElement('div');
    loadingDiv.id = `loading-${market}`;
    loadingDiv.className = 'text-center my-3';
    loadingDiv.innerHTML = '<i class="fa fa-spinner fa-spin me-2"></i>Loading preview...';
    previewContent.appendChild(loadingDiv);

    try {
        // Fetch data for this specific ensemble weight
        const { marketType, region } = window.currentFilterState;
        const response = await fetch(
            `/markets/ensemble-category-result?` +
            `marketType=${encodeURIComponent(marketType)}&` +
            `region=${encodeURIComponent(region)}&` +
            `markets=${encodeURIComponent(market)}&` +
            `ensembleWeight=${encodeURIComponent(ensembleWeight)}`
        );
        const result = await response.json();

        // Remove loading indicator
        const loader = document.getElementById(`loading-${market}`);
        if (loader) loader.remove();

        if (result.success) {
            displayPreviewData(market, ensembleWeight, result.data);
        } else {
            showFlashMessage(`Error loading preview: ${result.message}`, 'danger', 5000);
        }
    } catch (error) {
        console.error('Error fetching ensemble preview:', error);
        const loader = document.getElementById(`loading-${market}`);
        if (loader) loader.remove();
        showFlashMessage('Error loading preview data', 'danger', 5000);
    }
}

// Display preview data for a market
function displayPreviewData(market, ensembleWeight, data) {
    const previewContent = document.getElementById('ensemblePreviewContent');

    // Remove existing preview for this market
    const existingPreview = document.getElementById(`preview-${market}`);
    if (existingPreview) {
        existingPreview.remove();
    }

    // Create new preview section
    const previewSection = document.createElement('div');
    previewSection.id = `preview-${market}`;
    previewSection.className = 'preview-section mb-3 p-3 border rounded bg-light';

    if (data.length === 0) {
        previewSection.innerHTML = `
            <h6 class="text-warning"><i class="fa fa-exclamation-triangle me-2"></i>${market} - Ensemble Weight: ${ensembleWeight}</h6>
            <p class="text-muted mb-0">No data available for this selection</p>
        `;
    } else {
        const headers = Object.keys(data[0]);
        const displayRows = data.slice(0, 5); // Show only first 5 rows

        previewSection.innerHTML = `
            <h6 class="text-success"><i class="fa fa-check-circle me-2"></i>${market} - Ensemble Weight: ${ensembleWeight}</h6>
            <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
                <table class="table table-sm table-striped">
                    <thead class="table-dark">
                        <tr>${headers.map(h => `<th>${h}</th>`).join('')}</tr>
                    </thead>
                    <tbody>
                        ${displayRows.map(row => `
                            <tr>${headers.map(h => `<td>${row[h]}</td>`).join('')}</tr>
                        `).join('')}
                    </tbody>
                </table>
            </div>
            <p class="text-muted mb-0 mt-2">
                <i class="fa fa-info-circle me-2"></i>Showing ${displayRows.length} of ${data.length} rows
            </p>
        `;
    }

    previewContent.appendChild(previewSection);
}

// Clear preview for a specific market
function clearPreviewForMarket(market) {
    const preview = document.getElementById(`preview-${market}`);
    if (preview) {
        preview.remove();
    }
}

// Confirm button handler - execute R script and refresh
document.addEventListener('DOMContentLoaded', () => {
    const confirmBtn = document.getElementById('confirmEnsembleBtn');
    if (confirmBtn) {
        confirmBtn.addEventListener('click', async () => {
            // Collect all ensemble selections
            const ensembleSelections = {};
            const selectors = document.querySelectorAll('.ensemble-weight-select');

            selectors.forEach(select => {
                const market = select.dataset.market;
                const weight = select.value;

                if (weight) {  // Only include if not "Skip"
                    ensembleSelections[market] = weight;
                }
            });

            // Validate at least one selection
            if (Object.keys(ensembleSelections).length === 0) {
                showFlashMessage('Please select at least one ensemble weight or click "No, use default"', 'warning', 5000);
                return;
            }

            // Disable button and show loading
            confirmBtn.disabled = true;
            confirmBtn.innerHTML = '<i class="fa fa-spinner fa-spin me-2"></i>Processing...';

            try {
                // Call R script
                const { marketType } = window.currentFilterState;
                const response = await fetch('/markets/execute-ensemble-script', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        marketType,
                        ensembleSelections
                    })
                });

                const result = await response.json();

                if (result.success) {
                    // Close modal
                    const modal = bootstrap.Modal.getInstance(document.getElementById('ensembleModal'));
                    modal.hide();

                    // Refresh the entire report
                    await refreshReport();

                    showFlashMessage('Ensemble weights applied successfully!', 'success', 5000);
                } else {
                    showFlashMessage(`Failed to apply ensemble weights: ${result.message}`, 'danger', 5000);
                }
            } catch (error) {
                console.error('Error executing R script:', error);
                showFlashMessage('Error executing R script. Please try again.', 'danger', 5000);
            } finally {
                // Re-enable button
                confirmBtn.disabled = false;
                confirmBtn.innerHTML = '<i class="fa fa-check me-2"></i>Confirm & Apply';
            }
        });
    }
});

// Refresh report with updated data
async function refreshReport() {
    const { marketType, region, selectedMarkets, marketsParam } = window.currentFilterState;

    // Re-fetch all data
    const response = await fetch(
        `/markets/final-category-result?marketType=${encodeURIComponent(marketType)}&region=${encodeURIComponent(region)}&markets=${encodeURIComponent(marketsParam)}`
    );
    const result = await response.json();

    if (result.success && result.data.length > 0) {
        renderTable(result.data);
    }

    // Show all graphs
    await renderIncrementalChart(marketType);
    await renderFutureValueChart(marketType, region, marketsParam);
    await rendergreatestIncrementalityValuepoolChart(marketType, region, marketsParam);
    await renderMekkoCharts(marketType);
    await renderBubbleChart(marketType);

    // Expand all graph sections
    showAllGraphs();

    // Hide ensemble question
    hideEnsembleQuestion();
}
